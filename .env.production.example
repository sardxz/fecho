# ─────────────────────────────────────────────────────────────────────────
# Variáveis de PRODUÇÃO (VPS). Na VPS, copie pra `.env` na raiz do projeto e
# preencha. NUNCA comite o `.env` real — só este exemplo.
#
# Gere cada segredo forte com:   openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────

# ── Postgres (container interno, NÃO exposto à internet) ──
POSTGRES_USER="fecho"
POSTGRES_PASSWORD="TROCAR_senha_forte_postgres"
POSTGRES_DB="fecho"
# Host é "postgres" (nome do serviço no compose), não localhost. A senha aqui
# tem que ser idêntica à POSTGRES_PASSWORD acima.
DATABASE_URL="postgresql://fecho:TROCAR_senha_forte_postgres@postgres:5432/fecho"

# ── Auth.js ──
AUTH_SECRET="TROCAR_openssl_rand_base64_32"
AUTH_URL="https://fechoapp.com.br"
# Atrás do Nginx (reverse proxy), o Auth.js precisa confiar no host encaminhado.
AUTH_TRUST_HOST="true"

# ── Google OAuth ("Entrar com Google") ──
# ANTES do primeiro login em produção, cadastre no Google Cloud (Credenciais
# OAuth) as URLs de produção, senão dá redirect_uri_mismatch:
#   Origem JavaScript:  https://fechoapp.com.br
#   URI de redirect:    https://fechoapp.com.br/api/auth/callback/google
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret"

# ── Resend (magic link / recuperação de senha) ──
AUTH_RESEND_KEY="re_sua_chave"
AUTH_RESEND_FROM="Fechô <noreply@fechoapp.com.br>"

# ── Cron (geração diária de cobranças) ──
# O crontab da VPS chama POST /api/cron/generate-charges com este segredo no
# header Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="TROCAR_openssl_rand_base64_32"

# ── MinIO (container interno, NÃO exposto à internet) ──
MINIO_ROOT_USER="fecho_minio"
MINIO_ROOT_PASSWORD="TROCAR_senha_forte_minio"
# O Next fala com o MinIO pela rede interna do Docker (host "minio"). O
# navegador NUNCA acessa o MinIO direto — o comprovante é servido via Next.
S3_ENDPOINT="http://minio:9000"
# Estas duas têm que bater com MINIO_ROOT_USER / MINIO_ROOT_PASSWORD acima.
S3_ACCESS_KEY_ID="fecho_minio"
S3_SECRET_ACCESS_KEY="TROCAR_senha_forte_minio"
S3_BUCKET_NAME="proofs"
S3_REGION="us-east-1"
