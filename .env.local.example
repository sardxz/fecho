# Banco de dados (Docker local)
DATABASE_URL="postgresql://fecho:fecho@localhost:5432/fecho"

# Auth.js
# Gere com: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth ("Entrar com Google")
# Crie em https://console.cloud.google.com → APIs e Serviços → Credenciais →
# Criar credenciais → ID do cliente OAuth → Aplicativo da Web.
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="seu-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="seu-client-secret"

# Resend (magic link)
# Obtenha em: https://resend.com/api-keys
AUTH_RESEND_KEY="re_your_key_here"
# Remetente do magic link (domínio precisa estar verificado no Resend)
AUTH_RESEND_FROM="Fechô <noreply@fechoapp.com.br>"

# Cron (geração automática de cobranças) — segredo que a VPS envia no header
# Authorization: Bearer <CRON_SECRET>. Gere com: openssl rand -base64 32
CRON_SECRET="seu-segredo-aqui"

# Storage MinIO (Docker local)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="proofs"
S3_REGION="us-east-1"

# Mercado Pago (assinatura PRO)
# Use as credenciais de TESTE no dev (painel MP → Suas integrações → app →
# Credenciais de teste). O access token é secreto e só vive no servidor.
MP_ACCESS_TOKEN="TEST-seu-access-token"
# Segredo da assinatura do webhook (MP → Webhooks → "Assinatura secreta").
# O webhook valida o header x-signature com ele — sem isso, recusa tudo.
MP_WEBHOOK_SECRET="sua-assinatura-secreta-do-webhook"
